<#DependencyMapping>
  rml:logicalSource [
    rml:source "/home/alfonso/Escritorio/papr/tfg/level-of-trust-framework/intent-assurance/dxagent-master/generated/semantic_host1.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*].Dependency"
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/asset/{source}"
  ] ;
  rr:predicateObjectMap [
    rr:predicate lotaf:dependsOn ;
    rr:objectMap [ rr:template "https://example.org/asset/{target}" ]
  ] .
